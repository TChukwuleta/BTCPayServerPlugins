@using BTCPayServer.Plugins.SatoshiTickets.ViewModels
@model ReferrerLoginViewModel
@{
    ViewData["Title"] = "Referrer Login";
    Layout = "_BaseSimpleTicketPublicLayout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <h3 class="text-center mb-1">@Model.StoreName</h3>
            <p class="text-center text-muted mb-4">Referrer Login</p>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }

            <form asp-controller="UIReferrerPublic" asp-action="Login" asp-route-storeId="@Model.StoreId" method="post">
                <div class="form-group mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autofocus />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">Log In</button>
            </form>
        </div>
    </div>
</div>
