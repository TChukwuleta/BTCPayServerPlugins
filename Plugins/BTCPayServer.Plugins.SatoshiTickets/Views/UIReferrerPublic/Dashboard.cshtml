@using BTCPayServer.Plugins.SatoshiTickets.Data
@using BTCPayServer.Plugins.SatoshiTickets.ViewModels
@model ReferrerDashboardViewModel
@{
    ViewData["Title"] = "Referrer Dashboard";
    Layout = "_BaseSimpleTicketPublicLayout";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">Hi @Model.ReferrerName</h3>
        <a asp-controller="UIReferrerPublic" asp-action="Logout" asp-route-storeId="@Model.StoreId" class="btn btn-outline-secondary btn-sm">Log Out</a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            @if (!Model.AvailableBalances.Any())
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body text-center py-5">
                        <p class="text-muted mb-2">@Model.StoreName referral balance</p>
                        <div class="display-6 fw-bold mb-2">0</div>
                        <p class="text-muted">
                            Your running balance from ticket sales through your referral code(s)
                        </p>
                    </div>
                 </div>
            }
            else
            {
                <div class="d-flex flex-wrap justify-content-center gap-3 mb-4">
                    @foreach (var balance in Model.AvailableBalances)
                    {
                        <div class="card border-0 shadow-sm" style="min-width: 220px;">
                            <div class="card-body text-center py-4">
                                <p class="text-muted mb-2">Available balance</p>
                                <div class="display-6 fw-bold">@balance.Amount.ToString("N2")</div>
                                <p class="text-muted mb-0">@balance.Currency</p>
                            </div>
                        </div>
                    }
                </div>
                <p class= "text-muted text-center small" > Payouts are arranged directly with the organizer.</p>
            }
            
            @if (Model.RecentCredits.Any())
            {
                <h5 class="mt-4">Recent Activity</h5>
                <div class="table-responsive">
                    <table class="table table-sm table-hover">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Event</th>
                                <th>Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var credit in Model.RecentCredits)
                            {
                                <tr>
                                    <td>@credit.CreatedAt.ToString("MMM d, yyyy")</td>
                                    <td>@(credit.EventTitle ?? "—")</td>
                                    <td>@credit.Amount.ToString("N2") @credit.Currency</td>
                                    <td>
                                        @if (credit.Status == ReferralCreditStatus.Confirmed)
                                        {
                                            <span class="badge bg-success">Confirmed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Paid Out</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>