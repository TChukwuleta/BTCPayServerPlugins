@using BTCPayServer.Abstractions.Extensions
@using BTCPayServer.Abstractions.Models
@using BTCPayServer.Plugins.SatoshiTickets.Data
@using BTCPayServer.Plugins.SatoshiTickets.ViewModels
@using BTCPayServer.Services
@model EditReferrerViewModel
@inject DisplayFormatter DisplayFormatter
@{
    ViewData.SetLayoutModel(new LayoutModel(nameof(SatoshiTicketNavPages.SatoshiTicketReferrers), "Edit Referrer") { ActiveCategory = nameof(SatoshiTicketNavPages) });

    (string Badge, string Icon, string Label) StateDisplay(ReferrerState state) => state switch
    {
        ReferrerState.Active => ("bg-success", "done", "Active"),
        ReferrerState.Pending => ("bg-warning text-dark", "info", "Invitation pending"),
        _ => ("bg-secondary", "block", "Disabled")
    };
    var state = StateDisplay(Model.State);
}

<div class="sticky-header">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="UIReferrer" asp-action="Referrers" asp-route-storeId="@Model.StoreId">Referrers</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
        <h2>
            @Model.Name
            <span class="badge rounded-pill @state.Badge">@state.Label</span>
        </h2>
    </nav>
    <div>
        <button id="page-primary" type="submit" form="EditReferrerForm" class="btn btn-primary order-sm-1">Save</button>
    </div>
</div>

<partial name="_StatusMessage" />

<div class="row">
    <div class="col-xl-8 col-xxl-constrain">
        <form id="EditReferrerForm" asp-controller="UIReferrer" asp-action="SaveReferrer" asp-route-storeId="@Model.StoreId" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="StoreId" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="form-label">Email</label>
                <input class="form-control" value="@Model.Email" readonly disabled />
            </div>
        </form>
    </div>
</div>

<div class="row mt-5">
    <div class="col-xl-8 col-xxl-constrain">
        <h4 class="mb-3">Referral Credits</h4>

        @if (!Model.AvailableBalances.Any())
        {
            <p class="text-secondary mb-4">No confirmed referral credits yet - these show up automatically when a buyer uses this referrer's discount code.</p>
        }
        else
        {
            <div class="d-flex flex-wrap gap-4 mb-4">
                @foreach (var balance in Model.AvailableBalances)
                {
                    var formattedBalance = DisplayFormatter.Currency(balance.Amount, balance.Currency);
                    <div style="flex: 1 1 260px; min-width: 260px;">
                        <p class="text-secondary mb-1">Available balance · @balance.Currency</p>
                        <p class="h3 mb-3">@formattedBalance</p>
                        <a asp-controller="UIReferrer" asp-action="RecordPayout" asp-route-storeId="@Model.StoreId" asp-route-referrerId="@Model.Id" asp-route-currency="@balance.Currency"
                           class="btn btn-sm btn-primary text-nowrap">Mark as Paid</a>
                    </div>
                }
            </div>
        }

        <h5 class="mt-4">Recent Activity</h5>
        @if (!Model.RecentCredits.Any())
        {
            <p class="text-secondary">No referral credits recorded yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Event</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var credit in Model.RecentCredits)
                        {
                            <tr>
                                <td>@credit.CreatedAt.ToString("MMM d, yyyy")</td>
                                <td>@(credit.EventTitle ?? "—")</td>
                                <td>@DisplayFormatter.Currency(credit.Amount, credit.Currency)</td>
                                <td>
                                    @if (credit.Status == ReferralCreditStatus.Confirmed)
                                    {
                                        <span class="badge rounded-pill bg-success">Confirmed</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary">Paid Out</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (Model.PayoutHistory.Any())
        {
            <h5 class="mt-4">Payout History</h5>
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Amount</th>
                            <th>Note</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payout in Model.PayoutHistory)
                        {
                            <tr>
                                <td>@payout.CreatedAt.ToString("MMM d, yyyy")</td>
                                <td>@DisplayFormatter.Currency(payout.Amount, payout.Currency)</td>
                                <td>@(payout.Note ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>